{
  "manifest_version": 3,
  "name": "Local Call Recorder",
  "description": "Record Google Meet and Microsoft Teams calls locally with local transcript export. No cloud backend, telemetry, analytics, or upload path.",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "Local Call Recorder",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "service_worker.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "tabCapture",
    "downloads",
    "storage",
    "offscreen",
    "scripting"
  ],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://teams.microsoft.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*",
        "https://teams.microsoft.com/*"
      ],
      "js": ["content_script.js"],
      "css": ["content_overlay.css"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.svg",
    "48": "icons/icon48.svg",
    "128": "icons/icon128.svg"
  }
}
